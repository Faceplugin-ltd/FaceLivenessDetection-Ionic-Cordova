<?xml version='1.0' encoding='utf-8'?>
<widget id="com.faceplugin.faceliveness" android-packageName="com.faceplugin.faceliveness" ios-CFBundleIdentifier="com.faceplugin.faceliveness.app" version="0.2.0" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0" xmlns:android="http://schemas.android.com/apk/res/android">
    <name>FacePlugin Face Liveness</name>
    <description>FacePlugin Face Liveness demo for Apache Cordova — on-device passive anti-spoofing and guided active liveness, on the native FacePlugin screens.</description>
    <author email="info@faceplugin.com" href="https://faceplugin.com">FacePlugin</author>
    <content src="index.html" />
    <access origin="*" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />
    <allow-navigation href="*" />
    <preference name="Orientation" value="portrait" />
    <preference name="DisallowOverscroll" value="true" />
    <preference name="AndroidXEnabled" value="true" />
    <preference name="GradlePluginKotlinEnabled" value="true" />
    <preference name="GradlePluginKotlinVersion" value="1.9.24" />
    <preference name="android-minSdkVersion" value="24" />
    <preference name="AndroidWindowSplashScreenBackground" value="#000000" />
    <preference name="BackgroundColor" value="0x00000000" />
    <hook type="after_prepare" src="scripts/copy-android-icons.js" />
    <platform name="android">
        <preference name="AndroidPersistentFileLocation" value="Compatibility" />
        <edit-config file="app/src/main/AndroidManifest.xml" mode="merge" target="/manifest/application">
            <application android:largeHeap="true" />
        </edit-config>
        <icon density="ldpi" src="resources/android/res/mipmap-mdpi/ic_launcher.png" />
        <icon density="mdpi" src="resources/android/res/mipmap-mdpi/ic_launcher.png" />
        <icon density="hdpi" src="resources/android/res/mipmap-hdpi/ic_launcher.png" />
        <icon density="xhdpi" src="resources/android/res/mipmap-xhdpi/ic_launcher.png" />
        <icon density="xxhdpi" src="resources/android/res/mipmap-xxhdpi/ic_launcher.png" />
        <icon density="xxxhdpi" src="resources/android/res/mipmap-xxxhdpi/ic_launcher.png" />
    </platform>
    <platform name="ios">
        <preference name="deployment-target" value="14.0" />
        <icon src="resources/ios/icon.png" width="1024" height="1024" />
    </platform>
</widget>
